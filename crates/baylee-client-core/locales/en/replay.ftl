### One thing a replay says.

# The screen's full heading.
Replays = Replays

# Compact header navigation label.
NavReplays = Replays

# The end sheet's way into the game's replay.
WatchReplay = Watch replay

# A row's button.
Watch = Watch

# The end sheet of a replay: from the start again.
WatchAgain = Watch again

# The end sheet of a replay, and a row's menu: another perspective.
WatchFrom = Watch from…

# Back to the list.
BackToReplays = Back to replays

# The game menu's way out of a replay (Concede's place).
LeaveReplay = Leave replay

# A perspective: the viewer's seat.
YourSeat = Your seat

# A perspective: another seat (a record opened by hand). `{0}` its name.
# Arguments: arg0
SeatOf = { $arg0 }’s seat

# A perspective: the spectators' table.
TheTable = The table, as a spectator

# The perspective pill, short.
TheTableShort = The table

# A perspective: every hand.
AllHands = All hands

# The top line. `{0}` where, `{1}` when, `{2}` the perspective.
# Arguments: arg0, arg1, arg2
TopLine = Replay · { $arg0 } · { $arg1 } · { $arg2 }

# Where the step stands. `{0}` the turn, `{1}` whose, `{2}` the step.
# Arguments: arg0, arg1, arg2
WhereStep = Turn { $arg0 } · { $arg1 } · { $arg2 }

# The veil, a local projection. `{0}` percent.
# Arguments: arg0
RebuildingHere = Rebuilding the game… { $arg0 } %

# The veil, a hosted projection. `{0}` the gateway.
# Arguments: arg0
RebuildingThere = Rebuilding the game on { $arg0 }…

# The veil's way out.
EscCancels = Esc cancels

# Stopped early (`Verify::Stop`). `{0}` the turn, `{1}` the recording build.
# Arguments: arg0, arg1
StoppedDiverged = This version plays this game the same up to turn { $arg0 }; it was recorded by { $arg1 } and from there it would differ.

# Stopped: an answer refused. `{0}` the turn.
# Arguments: arg0
StoppedRefused = This version can’t play this game past turn { $arg0 }.

# The same build, a different hash.
StoppedMismatch = This replay doesn’t match the game it records. Please report it (F8).

# The record ends before the game does.
StoppedCut = The record ends here: the game went on, but no more of it was kept.

# The way past a divergence.
PlayOnAnyway = Play on anyway

# A list mark: checked on another build.
Checked = Checked

# Its hint. `{0}` the recording build.
# Arguments: arg0
CheckedHint = Recorded by { $arg0 }. This version plays it again and checks it against what the table showed.

# A list mark: recorded before the checks.
Unverified = Unverified

# Its hint.
UnverifiedHint = Recorded before replays were checked. This version may play it differently.

# The timeline's hatched band.
UnverifiedBand = unverified

# A seat whose account is gone.
FormerPlayer = Former player

# A seat bridge.
LanguageModel = Language model

# The house. `{0}` its level.
# Arguments: arg0
HouseLevel = House ({ $arg0 })

# The house, level unknown.
House = House

# The viewer, in a row.
You = You

# The next page of online games.
OlderOnline = Older online games

# The source filter.
FilterAll = All

# The source filter.
FilterHouse = Against the house

# The source filter.
FilterOnline = Online

# The result filter.
AnyResult = Any result

# A result.
Won = Won

# A result.
Lost = Lost

# A result.
Draw = Draw

# A result.
Unfinished = Unfinished

# A result nobody noted.
Ended = Ended

# A row's place: this computer.
ThisComputer = This computer

# A row: against the house. `{0}` the level.
# Arguments: arg0
VsHouse = vs House ({ $arg0 })

# A row's turns. `{0}` the turn.
# Arguments: arg0
TurnShort = T{ $arg0 }

# A row's length. `{0}` minutes.
# Arguments: arg0
Minutes = { $arg0 } min

# A day heading.
Today = Today

# A day heading.
Yesterday = Yesterday

# The search's hint.
SearchHint = Players, commanders…

# A row's menu, and the source filter: archived replays.
Archived = Archived

# A row's menu: archive it.
Archive = Archive

# A row's menu: bring it back.
Unarchive = Unarchive

# Said after archiving.
ArchivedNote = Archived. Archived replays stay available under “Archived”.

# Said after bringing one back.
UnarchivedNote = Back in your replays.

# The consent, on the end sheet and in a row's menu (§18.2).
ShareHand = Let others see my hand and deck in this game’s replay

# The consent's state on a menu row's cap.
On = On

# The consent's state on a menu row's cap.
Off = Off

# The archived list is empty.
NoArchived = Nothing archived. A replay you archive stays here and can be brought back.

# The empty list.
Empty = No replays yet. Games against the house are kept here (the last 20), and the games you play online are on the server you played them on.

# The list's foot line.
FootLine = A replay shows what you were shown at the table, and nothing you weren’t.

# No match for the filters.
NoMatch = No replay matches these filters.

# The online list could not be read.
OnlineUnread = The online games could not be listed.

# The transport bar: the start.
Start = Start

# The transport bar: the previous turn.
PrevTurn = Previous turn

# The transport bar: one moment back.
StepBack = One moment back

# The transport bar: play.
Play = Play

# The transport bar: pause.
Pause = Pause

# The transport bar: one moment on.
StepOn = One moment on

# The transport bar: the next turn.
NextTurn = Next turn

# The transport bar: the end.
End = End

# The transport bar: the speed.
Speed = Speed

# The timeline's hint over a turn. `{0}` the turn, `{1}` whose.
# Arguments: arg0, arg1
TurnHint = Turn { $arg0 } · { $arg1 }

# A seat whose hidden cards stay hidden in this replay.
NotShared = Hand not shared

# Its hint.
NotSharedHint = This player did not share their hand and deck for replays: their hidden cards stay hidden.

# The hand chip: fold the hand away.
FoldHand = Fold the hand away (I)

# The hand chip: bring it back.
ShowHand = Show the hand (I)

# The replay could not be made. `{0}` why.
# Arguments: arg0
Failed = This replay can’t be shown: { $arg0 }
