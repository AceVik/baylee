# Opt-in: an access log of the Impressum's honeypot only, for fail2ban
# (scripts/server/fail2ban/). The honeypot is a link on the Impressum page
# that no person sees (hidden by CSS, aria-hidden, not focusable, disallowed
# in robots.txt): whatever asks /site/impressum/kontakt follows every href
# it finds. The feedback service already answers such an address with
# invented details and the hardest puzzle for 24 hours, in memory
# (crates/baylee-feedback/src/impressum.rs); this file is only for an
# operator who also wants it banned at the firewall.
#
# Read before installing (owner decision): a fail2ban ban is the hard block
# the Impressum's rule otherwise never makes. It shuts the whole host (the
# game gateway too) for that address, and an address can be shared (mobile
# carriers' CGNAT, an office, a university): one robot behind it locks out
# the people behind it for the ban's time. The jail's defaults keep that
# short (two hits in an hour, banned for an hour).
#
# It keeps, for the honeypot path only, Caddy's JSON access line: the
# client's address, the time, the request line and headers Caddy logs, the
# user agent among them. Rolled at 1 MiB, two old files kept; nothing else
# on the site is logged (docs/privacy.md §"The Impressum").
#
# Install (as root), after scripts/server/site.caddy:
#
#   install -m644 scripts/server/impressum-honeypot.caddy /etc/caddy/baylee-impressum-honeypot.caddy
#
# and in the gateway's site block, beside the site snippet:
#
#   import /etc/caddy/baylee-impressum-honeypot.caddy
#
# then `caddy validate --config /etc/caddy/Caddyfile` and `systemctl reload
# caddy`. `log_skip` needs Caddy 2.8 or newer (before: `skip_log`). It
# skips every other request of this site block, so if the block has a `log`
# of its own already, do not import this file: add the honeypot's matcher to
# that log's filter instead.

log baylee_impressum_honeypot {
	output file /var/log/caddy/baylee-impressum-honeypot.log {
		roll_size 1MiB
		roll_keep 2
	}
	format json
}
@baylee_not_honeypot not path /site/impressum/kontakt
log_skip @baylee_not_honeypot
