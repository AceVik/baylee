# Tower Echoes' authority (docs/tower-operations.md §"Production on one
# server"). Installed once to /etc/systemd/system/; a new service binary is
# installed by hand, and a restart never ends a duel: the gateway holds the
# game, and the queue resumes verification from the database.
#
# The configuration (the runtime role's database URL, the verifier,
# supervisor and courier credentials and Central's award issuer credential)
# is /etc/baylee-tower/service.json, root 0600, handed over as standard
# input; the service reads it once and closes the pipe. It listens on
# loopback only; Caddy (scripts/server/tower.caddy) is the public side. It
# calls Central (central.baylee.app) for identity introspection and award
# delivery, and starts the retained Tower engine named in that file to
# verify records.
[Unit]
Description=Baylee: Tower Echoes authority (tower.baylee.app)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=baylee-tower
Group=baylee-tower
ExecStart=/opt/baylee-tower/bin/baylee-tower-service
StandardInput=file:/etc/baylee-tower/service.json
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
# No system-call filter: the service starts the Tower engine to replay records,
# and the engine runs unfiltered under the agent as well.
# Verification replays one record per worker in the engine it starts.
MemoryMax=4G
TasksMax=512

[Install]
WantedBy=multi-user.target
