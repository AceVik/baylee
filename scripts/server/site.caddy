# The landing page at https://<gateway host>/ (web/site/).
#
# Directives for the gateway's own site block, served ahead of the gateway:
# exactly `/` is the page, `/favicon.ico` its icon (browsers ask for it
# unasked, and the gateway would answer 404), `/robots.txt`, everything under
# /site/ its files (the Impressum is /site/impressum.html, its details come
# from the feedback service under /site/impressum/, below), and everything
# else stays the gateway's (/info, /lobby, /health, /terms, /catalog, …) or
# the browser client's (/play/,
# scripts/server/play.caddy). /site/ is no route of the gateway's, so the
# two never meet.
#
# Install (once, as root):
#
#   install -d /opt/baylee/web
#   cp -R web/site /opt/baylee/web/site.new
#   rm -rf /opt/baylee/web/site && mv /opt/baylee/web/site.new /opt/baylee/web/site
#   install -m644 scripts/server/site.caddy /etc/caddy/baylee-site.caddy
#
# and in the gateway's site block (the file under /etc/caddy/sites/), import
# it beside the play snippet, before the proxy's `handle`, so no two of them
# answer one request:
#
#   gateway.baylee.app {
#       import /etc/caddy/baylee-play.caddy
#       import /etc/caddy/baylee-site.caddy
#       handle {
#           reverse_proxy 127.0.0.1:28766
#       }
#   }
#
# then `caddy validate --config /etc/caddy/Caddyfile` and
# `systemctl reload caddy`. Not under sites/: that directory is imported at
# the top level, where these directives mean nothing. To update the page,
# repeat the copy and the rename; nothing in Caddy changes.
#
# No `log` here, on purpose, like the other snippets: the page keeps nothing
# about a visitor, and an access log would. The privacy notice
# (web/site/datenschutz.html) says so; adding a log means changing it.

# The Impressum's details (web/site/impressum.html): the feedback service
# hands them out for a solved proof of work and answers a honeypot, all
# under /site/impressum/ (crates/baylee-feedback/src/impressum.rs,
# docs/feedback.md §"The Impressum"). Passed on from here, so the page asks
# its own origin and the service sees `Sec-Fetch-Site: same-origin`. Ahead
# of the page's handle below: Caddy keeps named matchers in file order, and
# /site/impressum.html is not under /site/impressum/, so the two never meet.
# The service needs FEEDBACK_TRUSTED_PROXIES=127.0.0.1 (it has it for the
# contact form) to count the visitor's address and not Caddy's.
@baylee_impressum path /site/impressum /site/impressum/*
handle @baylee_impressum {
	request_body {
		max_size 8KiB
	}
	reverse_proxy 127.0.0.1:28780
}

@baylee_site path / /favicon.ico /robots.txt /site/*
handle @baylee_site {
	root * /opt/baylee/web/site
	# `/site/site.css` is `site.css` in that folder; `/` and `/favicon.ico`
	# are left as they are and file_server finds index.html for `/`.
	uri strip_prefix /site

	# The page is asked again on every visit and answered 304 when nothing
	# changed, so a new build shows at once. The stylesheet and the script
	# change with the page and are not named by content, so an hour; fonts
	# and pictures a week. Everything is revalidated once it is stale.
	# (`header` runs before `uri`, so these matchers see the path as asked;
	# the Impressum is named both ways to hold if that order ever changes.)
	@page path / /site/impressum.html /impressum.html /site/datenschutz.html /datenschutz.html
	header @page Cache-Control "no-cache"
	# The card status (data/*.json, crates/baylee-tools/src/site/card_status.rs) is
	# regenerated with the cards, so it is treated like the code.
	# A file the page names with ?v=<its hash> (crates/baylee-tools/src/site/stamp.rs) never
	# changes under that name: a year, immutable. Unstamped, as before.
	@stamped {
		path *.css *.js *.woff2 *.webp *.avif *.png *.jpg *.ico
		query v=*
	}
	header @stamped Cache-Control "public, max-age=31536000, immutable"
	@code {
		path *.css *.js *.json *.txt
		not query v=*
	}
	header @code Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
	@assets {
		not path / /site/impressum.html /impressum.html /site/datenschutz.html /datenschutz.html *.css *.js *.json *.txt
		not query v=*
	}
	header @assets Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

	# What the page may do: its own files, GitHub's API for the release
	# list and the CI status (site.js), and card pictures straight from
	# Scryfall's image host when a visitor opens a set in the card status
	# (docs/legal.md §3; never Scryfall's API, nothing re-hosted), and the
	# feedback service's POST /site/contact for the contact form (fetch;
	# docs/feedback.md §"The landing page's contact form"). No inline
	# style or script, nothing else from any other host; the downloads are
	# links the browser follows, which no CSP directive governs. The
	# gateway's /info and /health are 'self'.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://cards.scryfall.io; font-src 'self'; connect-src 'self' https://api.github.com https://feedback.baylee.app; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# The Impressum is for people who look for it, not for search engines
	# (robots.txt disallows it too; no sitemap names it).
	@impressum path /site/impressum.html /impressum.html
	header @impressum X-Robots-Tag "noindex, noarchive, nosnippet"

	encode zstd gzip
	file_server
}
