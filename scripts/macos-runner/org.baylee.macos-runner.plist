<?xml version="1.0" encoding="UTF-8"?>
<!-- The macOS package rows' runner (docs/releasing.md §"The macOS runner").
     `baylee-macos-runner install` writes this with @HOME@ filled in to
     ~/Library/LaunchAgents and loads it into the owner's session: Tart's VMs
     need the logged-in user, and so does the keychain the token is kept in. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.baylee.macos-runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/baylee-ci/baylee-macos-runner</string>
        <string>serve</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Let VM/registration cleanup finish before launchd forces termination. -->
    <key>ExitTimeOut</key>
    <integer>180</integer>
    <!-- A failing start (no token, no network) is retried, not hammered. -->
    <key>ThrottleInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/baylee-macos-runner.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/baylee-macos-runner.log</string>
</dict>
</plist>
