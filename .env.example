# Client and server configuration. Copy to `.env` — it is git-ignored.

# The gateway the client signs in to, plays at, and fetches card text from.
# The client reads BAYLEE_GATEWAY from the environment first, this file
# second, and falls back to the development default below. In a browser the
# page's own origin is used and this setting is ignored.
BAYLEE_GATEWAY=http://127.0.0.1:28766

# A seat at a game on that gateway. With both of these the client goes
# straight to that table instead of showing its own lobby; without them
# nothing changes. `POST /lobby/games` (or `.../join`) answers with exactly
# these two values, which is also what the lobby does for itself. In a
# browser the same handover is `?game=…&token=…` on the page URL.
# BAYLEE_SEAT is a hint only — the table says which chair it is.
# BAYLEE_GAME=0199-…
# BAYLEE_SEAT_TOKEN=…
# BAYLEE_SEAT=0

# The gateway's database. Required — it is where the accounts are, so a
# gateway without it refuses to start. `docker compose up -d` provides
# exactly this one.
#
# The card catalog lives in the same database and is the optional half:
# without `cargo run -p baylee-catalog -- ingest` the gateway serves no card
# text and the client draws faces from what the engine projects.
DATABASE_URL=postgres://baylee:baylee@127.0.0.1:5432/baylee

# How many connections one gateway keeps open (default 8). The number that
# binds is at the other end: a stock PostgreSQL allows 100 in total, so a
# machine running several gateways at once wants this small.
# BAYLEE_DB_POOL=8
