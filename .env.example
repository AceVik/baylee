# Client and server configuration. Copy to `.env` — it is git-ignored.

# Where the duel client fetches card text (the gateway's HTTP address).
# The client reads BAYLEE_GATEWAY from the environment first, this file
# second, and falls back to the development default below. In a browser the
# page's own origin is used and this setting is ignored.
BAYLEE_GATEWAY=http://127.0.0.1:28766

# The gateway's card catalog. Without it the gateway still runs every game;
# it just serves no card text and the client draws faces from what the
# engine projects. `docker compose up -d` provides exactly this database.
DATABASE_URL=postgres://baylee:baylee@127.0.0.1:5432/baylee
