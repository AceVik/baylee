# Client auto-login configuration for development and QA.
# Copy to `.env.auto-login` (which is git-ignored) and run:
#   cargo run -p baylee-client -- --auto-login-env .env.auto-login

# Required: Baylee Central account credentials.
BAYLEE_AUTO_LOGIN_USERNAME=your_username
BAYLEE_AUTO_LOGIN_PASSWORD=your_password

# Optional: Gateway URL to enter automatically right after Central sign-in.
# Must be an http:// or https:// URL without embedded credentials, query, or fragment.
# BAYLEE_AUTO_LOGIN_GATEWAY=http://127.0.0.1:28766

# Optional: Account contact email (for QA/test tooling reference).
# BAYLEE_AUTO_LOGIN_EMAIL=qa@example.com
